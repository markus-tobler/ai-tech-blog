{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "microsoft-docs@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["astro-docs"],
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm verify)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm astro dev *)",
      "Bash(pnpm install)",
      "Bash(vale *)",
      "Bash(lychee *)",
      "Bash(npx cspell *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "mcp__astro-docs",
      "mcp__plugin_microsoft-docs_microsoft-learn"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
