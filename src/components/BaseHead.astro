---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { LOCALES, type Lang } from '../config';
import { url, useTranslations } from '../i18n/utils';

export interface Alternate {
	lang: Lang;
	href: string;
}

interface Props {
	lang: Lang;
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	alternates?: Alternate[];
	noindex?: boolean;
}

const { lang, title, description, image, type = 'website', alternates = [], noindex = false } = Astro.props;
const t = useTranslations(lang);
const siteTitle = t('site.title');
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
	? new URL((await getImage({ src: image, width: 1200, format: 'jpeg' })).src, Astro.site)
	: new URL(url('og-default.png'), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="icon" href={url('favicon.ico')} sizes="32x32" />
<link rel="sitemap" href={url('sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${siteTitle} (${LOCALES[lang]})`} href={url(`${lang}/rss.xml`)} />
<meta name="generator" content={Astro.generator} />
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-serif" preload />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Markus Tobler" />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}
{alternates.map((a) => <link rel="alternate" hreflang={LOCALES[a.lang]} href={new URL(a.href, Astro.site)} />)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={LOCALES[lang].replace('-', '_')} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
