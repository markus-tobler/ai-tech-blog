---
import type { Lang } from '../config';
import { otherLang, url, useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	/** Target of the language switch. Defaults to the other language's home page. */
	switchHref?: string;
}

const { lang, switchHref = url(`${otherLang(lang)}/`) } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const home = url(`${lang}/`);
const about = url(`${lang}/about/`);
---

<a class="skip-link" href="#content">{t('nav.skip')}</a>
<header class="page site-header">
	<a class="brand" href={home}>
		<span class="brand-name">{t('site.title')}</span>
		<span class="brand-tagline">{t('site.tagline')}</span>
	</a>
	<nav aria-label="Main">
		<a href={home} aria-current={path === home ? 'page' : undefined}>{t('nav.home')}</a>
		<a href={about} aria-current={path === about ? 'page' : undefined}>{t('nav.about')}</a>
		<a href={url(`${lang}/rss.xml`)}>{t('nav.rss')}</a>
		<a href={switchHref} hreflang={otherLang(lang)} lang={otherLang(lang)} class="lang-switch">{t('lang.switch')}</a>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-top: 1.75rem;
		padding-bottom: 1.75rem;
		font-family: var(--sans);
	}
	.brand {
		display: flex;
		flex-direction: column;
		color: var(--ink);
		text-decoration: none;
		line-height: 1.2;
	}
	.brand-name {
		font-weight: 700;
		font-size: var(--step-1);
		letter-spacing: -0.01em;
	}
	.brand-tagline {
		color: var(--ink-soft);
		font-size: var(--step--1);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: var(--step--1);
	}
	nav a {
		color: var(--ink);
		text-decoration: none;
		padding: 0.25em 0;
		border-bottom: 2px solid transparent;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		border-bottom-color: currentColor;
	}
	.lang-switch {
		color: var(--link);
	}
</style>
