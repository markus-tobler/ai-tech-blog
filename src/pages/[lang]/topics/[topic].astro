---
import PostList from '../../../components/PostList.astro';
import { LANGS, TOPICS } from '../../../config';
import { topicNames } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getListing } from '../../../lib/posts';

export function getStaticPaths() {
	return LANGS.flatMap((lang) => TOPICS.map((topic) => ({ params: { lang, topic } })));
}

const { lang, topic } = Astro.params;
const t = useTranslations(lang);
const name = topicNames[lang][topic];
const posts = (await getListing(lang)).filter((p) => p.data.topic === topic);
---

<BaseLayout lang={lang} title={name} description={`${t('topic.label')} ${name}`}>
	<header class="grid list-head">
		<h1 class="main topic-mark" data-topic={topic}>{name}</h1>
	</header>
	{posts.length > 0 ? <PostList lang={lang} posts={posts} /> : <p class="grid"><span class="main">{t('home.empty')}</span></p>}
</BaseLayout>

<style>
	.list-head {
		padding: 2.5rem 0 2rem;
	}
	h1 {
		margin: 0;
		color: var(--lane);
	}
</style>
