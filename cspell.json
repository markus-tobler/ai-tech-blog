{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": [
    "@cspell/dict-de-ch/cspell-ext.json"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project-words"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    ".astro",
    ".vale",
    "pnpm-lock.yaml"
  ],
  "ignoreRegExpList": [
    "/^---[\\s\\S]*?^---/gm",
    "/`[^`]*`/g",
    "/\\]\\([^)]*\\)/g"
  ],
  "overrides": [
    {
      "filename": [
        "**/en/**",
        "**/*.en.md"
      ],
      "language": "en-GB"
    },
    {
      "filename": [
        "**/de/**",
        "**/*.de.md"
      ],
      "language": "de-CH,en-GB",
      "allowCompoundWords": true
    }
  ]
}
