{
  "name": "ai-tech-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint:prose": "vale src/content social",
    "lint:spell": "cspell --no-progress --show-suggestions \"src/content/**/*.{md,mdx}\" \"social/**/*.md\"",
    "lint:links": "lychee --config lychee.toml --root-dir \"$PWD/dist\" dist",
    "verify": "pnpm check && pnpm build && pnpm lint:prose && pnpm lint:spell && pnpm lint:links"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cspell/dict-de-ch": "^1.3.3",
    "cspell": "^10.4.0",
    "typescript": "^6.0.3"
  }
}
